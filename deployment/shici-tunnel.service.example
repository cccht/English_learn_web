[Unit]
Description=Cloudflare Tunnel for Shici
After=network-online.target shici-web.service
Wants=network-online.target shici-web.service

[Service]
User=shici
Group=shici
Type=simple
WorkingDirectory=/opt/shici
ExecStart=/usr/bin/node /opt/shici/scripts/run-tunnel.mjs
Restart=always
RestartSec=5
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=multi-user.target
