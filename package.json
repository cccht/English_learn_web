{
  "name": "shici-cet6-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/app.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server/app.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src server tests vite.config.ts index.html README.md"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.6",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@tailwindcss/vite": "^4.1.13",
    "cookie": "^2.0.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "perfect-freehand": "^1.2.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.13",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  }
}
